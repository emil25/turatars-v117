  const arr = [{n:"Szendvics", i:"🥪", checked:false}, {n:"Banán", i:"🍌", checked:false}];
  if (h>=3) arr.push({n:"Energia-szelet, mogyoró", i:"🍫", checked:false});
  if (h>=5) arr.push({n:"Meleg étel a túra végére / termosz", i:"🍲", checked:false});
  return arr;
};
