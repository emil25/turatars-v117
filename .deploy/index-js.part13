VIEWS.workspace.after = (root,id)=>{ _prjWS18 && _prjWS18(root,id); 
  root.querySelectorAll("[data-openmem-ws]").forEach(b=>b.onclick=()=>{ const t=Store.getTour(id); if(t) openMemoryEditor(t); }); };

