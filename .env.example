# .env.example — PÉLDÁK csupán. Valódi titkot NE tegyél ide és NE commitold a .env-et.
# V54.1: ezek NINCSENEK használatban (a kliens localStorage-first). V54.2 szerver-oldal:

# --- QW Pages dynamic + Supabase-kompatibilis adatbázis (TERV, ld. CLOUD_MIGRATION.md) ---
# az Alkalmazás-szervernek (Node) — a FRONToNd bundle-be soha:
SUPABASE_URL=
SUPABASE_ANON_KEY=
SUPABASE_INSTANCE_ID=
# service-role KULCS TILOS frontendbe; csak a szerver kapja meg, ha egyáltalán kell
# (a QW Page Supabase-modell szerint az anon key a szerver-oldali elérése; a kliens az
#  API-t hívja a saját opaque tokenjével).

# --- V54 kliens-vége (opcionális, V54.2) ---
# window.V54_CLOUD_BASE_URL JS-ben vagy alábbi build-idő injecteléssel:
V54_CLOUD_BASE_URL=

# --- teszt-env (RUNBOOK) ---
# Playwright chromium path a tesztekben (hardcodeolt default):
# /opt/playwright-browsers/chromium-1209/chrome-linux64/chrome

# --- V54 Supabase snapshot cloud (PUBLIC frontend configuration) ---
# With false/missing configuration the V117.1 local vault remains active.
VITE_TT_SUPABASE_ENABLED=false
VITE_SUPABASE_URL=
VITE_SUPABASE_PUBLISHABLE_KEY=
# Do not set V54_CLOUD_BASE_URL and enable the Supabase adapter simultaneously.
# Auth confirmation/reset callbacks must use an allowed deployment URL.
# No secret/service-role/DB password variable may start with VITE_.
# The client uses user JWT + RLS and needs NO service-role key.
